<Window x:Class="spacebattle1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Battle Multiplayer" Height="650" Width="820" Background="Black"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp" WindowStartupLocation="CenterScreen">
    <Grid>
        <Canvas x:Name="GameCanvas" Width="800" Height="600" Background="#050515" Visibility="Collapsed"/>

        <StackPanel x:Name="HudPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0" Visibility="Collapsed">
            <TextBlock x:Name="TxtArmor" Text="HULL INTEGRITY: 100%" Foreground="Red" FontSize="18" FontWeight="Bold" Margin="0,0,30,0"/>
            <TextBlock x:Name="TxtScore" Text="GALAXY SCORE: 0" Foreground="Gold" FontSize="18" FontWeight="Bold" Margin="0,0,30,0"/>
            <TextBlock x:Name="TxtCombo" Text="" Foreground="Cyan" FontSize="18" FontWeight="Bold" Margin="0,0,30,0"/>
            <TextBlock Text="[Enter] - Пауза | [F1] - Довідка" Foreground="LightBlue" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="TxtGameOver" Text="GAME OVER" Foreground="OrangeRed" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" TextAlignment="Center"/>

        <TextBlock x:Name="TxtPause" Text="СИСТЕМНА ПАУЗА&#x0a;[ Натисніть ENTER для повернення ]" Foreground="Yellow" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" TextAlignment="Center"/>

        <StackPanel x:Name="MenuPanel" Width="300" Height="220" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Введіть адресу сервера:" Foreground="White" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <TextBox x:Name="TxtIp" Text="127.0.0.1" FontSize="14" HorizontalAlignment="Stretch" Margin="0,0,0,15" Padding="6"/>
            <Button Content="Establish Link" FontSize="14" Background="#FF2D2D5F" Foreground="White" Click="BtnConnect_Click" Padding="10" Margin="0,0,0,10"/>
            <Button Content="Довідка програміста (F1)" FontSize="12" Background="#FF3D3D3D" Foreground="LightGray" Click="BtnHelp_Click" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>